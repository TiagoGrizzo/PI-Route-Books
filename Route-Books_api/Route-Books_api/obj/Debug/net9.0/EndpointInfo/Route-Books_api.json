    "/api/Chat/historico": {
      "get": {
        "tags": [
          "Chat"
        ],
        "summary": "Obter histórico de chat",
        "description": "Retorna as mensagens entre dois usuários e marca as recebidas como lidas.",
        "parameters": [
          {
            "name": "meuId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "idDoAmigo",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Chat/enviar": {
      "post": {
        "tags": [
          "Chat"
        ],
        "summary": "Enviar mensagem de chat",
        "description": "Salva uma nova mensagem no MongoDB recebendo diretamente a model.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MensagemChat"
