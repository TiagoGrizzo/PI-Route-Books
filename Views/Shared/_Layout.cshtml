@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Route Books</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />

    <link rel="stylesheet" href="~/css/reset.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/color.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">

    <header class="header-navbar">
        <nav class="navbar navbar-expand-lg bg-body-tertiary bg-navbar container-xxl">
            <div class="container-fluid">

                <a class="navbar-brand-text-color-navbar" asp-controller="Posts" asp-action="Index">
                    <img src="~/imgs/rb-logo2.png" class="logo-tamanho" alt="Logo Route Books">
                </a>

                <button class="navbar-toggler bg-color-menu-btn" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link active text-color-navbar titulo-font" asp-controller="Posts" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-color-navbar titulo-font" asp-controller="Usuarios" asp-action="Index">Aventureiros</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-color-navbar titulo-font" asp-controller="Home" asp-action="QuemSomos">Sobre</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-color-navbar titulo-font" asp-controller="Home" asp-action="Contato">Contato</a>
                        </li>
                    </ul>

                    <!-- MUDANÇA NA BARRA DE PESQUISA, AGR ELA PEGA OS POSTS DO BANCO E NOS LEVA PARA A PAGINA DE VER POSTS. AGR A BARRA FUNCIONA! -->
                    <form class="d-flex barra-pesquisa" 
                          asp-controller="Posts"
                          asp-action="VerPosts"
                          method="get">

                        <input class="form-control me-2 search-bar"
                               type="search"
                               name="busca"
                               value="@ViewBag.Busca"   
                               placeholder="Pesquisar"
                               aria-label="Search" />

                        <button class="btn btn-outline-success" type="submit">
                            <i class="fa fa-search" aria-hidden="true"></i>
                        </button>

                    </form>

                </div>

                <div class="dropdown perfil-geral">
                    <button class="btn btn-secondary dropdown-toggle btn-perfil" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa fa-user-o" aria-hidden="true"></i>
                        @if (Context.Session.GetInt32("UsuarioId") != null)
                        {
                            @(" " + Context.Session.GetString("UsuarioNome"))
                        }
                        else
                        {
                            @(" Entrar")
                        }
                    </button>

                    <ul class="dropdown-menu menu-perfil">
                        @if (Context.Session.GetInt32("UsuarioId") != null)
                        {
                            <li><a class="dropdown-item perfil-item" href="#">Perfil</a></li>
                            <li><a class="dropdown-item perfil-item" asp-controller="Posts" asp-action="Create">Criar Postagem</a></li>
                            <li><a class="dropdown-item perfil-item" asp-controller="Usuarios" asp-action="Sair">Sair da conta</a></li>
                        }
                        else
                        {
                            <li><a class="dropdown-item perfil-item" asp-controller="Usuarios" asp-action="Login">Fazer Login</a></li>
                            <li><a class="dropdown-item perfil-item" asp-controller="Usuarios" asp-action="Create">Cadastre-se</a></li>
                        }
                    </ul>

                    <div class="dark-mode-toggle">
                        <button class="btn-dark-mode" onclick="toggleDarkMode()">
                            <i class="fa fa-moon-o dark-icon" aria-hidden="true"></i>
                            <i class="fa fa-sun-o light-icon" aria-hidden="true"></i>
                        </button>
                    </div>

                </div>

                
            </div>
        </nav>
    </header>

    <!-- <main>: Define a área de conteúdo principal e injeta a View ativa (@RenderBody). 
     class="flex-grow-1": Força essa área a esticar e ocupar todo o espaço vago, empurrando o footer para o rodapé. -->
    <main role="main" class="flex-grow-1">
        @RenderBody() <!-- IMPORTANTE! -->
    </main>

    <!-- FOOTER GLOBAL (Aparecerá em todas as páginas) -->
    <footer class="footer-index">
        <div class="itens-footer-geral">
            <div class="item-footer item-footer-direitos">
                <h4 class="titulo-font">
                    Route Books © Todos os direitos reservados
                </h4>
            </div>

            <div class="item-footer">
                <h4 class="titulo-font">
                    Desenvolvido por:
                    <br>
                    <a href="https://github.com/LucasEduardoPereiraCruz" target="_blank">
                        Lucas Cruz
                    </a>
                    <br>
                    <a href="https://github.com/TiagoGrizzo" target="_blank">
                        Tiago Grizzo
                    </a>
                </h4>
            </div>

            <div class="logo-footer">
                <img src="~/imgs/rb-logo2.png" class="logo-footer" alt="Logo Route Books">
            </div>
        </div>
    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Função para aplicar o tema e atualizar a logo
        function aplicarTema(isDark) {
            if (isDark) {
                document.body.classList.add('dark-mode');
            } else {
                document.body.classList.remove('dark-mode');
            }

            const logo = document.getElementById('logoSobre');
            if (logo) {
                logo.src = isDark ? '/imgs/rb-logo2.png' : '/imgs/rb-logo1.png';
            }
        }

        // Função do Botão Toggle
        function toggleDarkMode() {
            const isDarkAtual = document.body.classList.contains('dark-mode');
            const novoEstadoDark = !isDarkAtual;

            // Salva a preferência no navegador do usuário
            localStorage.setItem('theme', novoEstadoDark ? 'dark' : 'light');

            // Aplica as mudanças de classe e logo
            aplicarTema(novoEstadoDark);
        }

        // Executa assim que a página carrega (em QUALQUER tela, inclusive no Chat)
        document.addEventListener('DOMContentLoaded', function() {
            const temaSalvo = localStorage.getItem('theme');
            if (temaSalvo === 'dark') {
                aplicarTema(true);
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>