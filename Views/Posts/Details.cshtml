@model PI_RouteBooks.Models.Post

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Detalhes do Post</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Titulo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Titulo)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Resumo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Resumo)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Conteudo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Conteudo)
        </dd>

        <dt class="col-sm-2">
            Categoria
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CategoriaRef.Nome)
        </dd>

        <dt class="col-sm-2">
            Tipo de Post
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TipoRef.nomeTipo)
        </dd>

        <dt class="col-sm-2">
            Autor
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Autor.Username)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
    </dl>

    @if (!string.IsNullOrEmpty(Model.ImagemUrl))
    {
        <div class="my-3 text-center">
            <img src="@Model.ImagemUrl"
                 alt="Imagem de @Model.Titulo"
                 class="img-fluid rounded shadow-sm"
                 style="max-height: 400px; width: 100%; object-fit: cover;" />
        </div>
    }
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.IdPost">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
