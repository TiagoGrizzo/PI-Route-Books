@model IEnumerable<PI_RouteBooks.Models.MensagemChat>

@{
    ViewData["Title"] = "Conversa com " + ViewBag.AmigoNome;
}

<div class="container container-xxl mt-4 flex-grow-1">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden;">

                <div class="card-header bg-dark text-white p-3 d-flex align-items-center justify-content-between" style="background-color: #2c3e50 !important;">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-user-circle-o me-2" style="font-size: 1.6rem; color: #27ae60;"></i>
                        <h5 class="mb-0 titulo-font">@ViewBag.AmigoNome</h5>
                    </div>
                    <span class="badge bg-success" style="font-size: 11px; border-radius: 10px;">Chat Privado</span>
                </div>

                <div class="card-body bg-light" id="chat-box" style="height: 430px; overflow-y: auto; padding: 20px;">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var msg in Model)
                        {
                            var ehMinhaMensagem = msg.RemetenteId == Context.Session.GetInt32("UsuarioId");

                            <div class="d-flex @(ehMinhaMensagem ? "justify-content-end" : "justify-content-start") mb-3">
                                <div class="card p-2 px-3 shadow-sm"
                                     style="max-width: 75%; border-radius: 15px;
                                                    background-color: @(ehMinhaMensagem ? "#27ae60" : "#ffffff");
                                                    color: @(ehMinhaMensagem ? "#ffffff" : "#333333");">

                                    <p class="mb-0" style="font-size: 14px; word-break: break-word;">@msg.Texto</p>

                                    <small class="d-block text-end mt-1" style="font-size: 9px; opacity: 0.7;">
                                        @msg.EnviadoEm.ToString("HH:mm")
                                    </small>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted mt-5 py-5">
                            <i class="fa fa-envelope-o d-block mb-3" style="font-size: 3.5rem; opacity: 0.2; color: #27ae60;"></i>
                            <h6 class="titulo-font">Inicie a conversa!</h6>
                            <p class="small text-secondary">Diga um "Olá" para @ViewBag.AmigoNome e comecem a conversar.</p>
                        </div>
                    }
                </div>

                <div class="card-footer bg-white p-3 border-top-0">
                    <form asp-controller="Chat" asp-action="Enviar" method="post" class="d-flex">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="destinatarioId" value="@ViewBag.AmigoId" />

                        <input type="text" name="texto" class="form-control me-2 search-bar"
                               placeholder="Enviar mensagem para @ViewBag.AmigoNome..." autocomplete="off" required
                               style="border-radius: 20px; padding: 10px 20px;" />

                        <button type="submit" class="btn btn-success px-4" style="border-radius: 20px; background-color: #27ae60; border: none;">
                            <i class="fa fa-paper-plane" aria-hidden="true"></i>
                        </button>
                    </form>
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        var chatBox = document.getElementById("chat-box");
        if (chatBox) {
            chatBox.scrollTop = chatBox.scrollHeight;
        }
    </script>
}
